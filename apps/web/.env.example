# Server-only database credential. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=

# Local bridge mode used by scripts/start-local.mjs.
FINCITE_API_URL=http://127.0.0.1:8081

# Optional: run the hosted API path locally without starting a bridge.
# FINCITE_BACKEND=hosted
# Vercel selects hosted mode automatically; no FINCITE_API_URL is needed there.
